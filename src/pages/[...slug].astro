---
import CanvasComponentTree from '@drupal-canvas/headless-astro/CanvasComponentTree.astro'
import SiteLayout from '@/src/layouts/SiteLayout.astro'
import ParagraphRenderer from '@/src/components/paragraphs/ParagraphRenderer.astro'
import { getClient } from '@/lib/drupal-client'
import { transformSections } from '@/lib/drupal-utils'
import { loadCanvasPage, isPageRedirect } from '@/lib/canvas'
import type { NodeLandingPage } from '@/schema/client'

const { slug } = Astro.params
const path = `/${(slug ?? '').split('/').map(encodeURIComponent).join('/')}`

// 1. Drupal Canvas pages (draft-aware inside the Canvas editor).
const canvasPage = await loadCanvasPage(Astro, path)
if (canvasPage && isPageRedirect(canvasPage)) {
  return Astro.redirect(canvasPage.redirect.url, canvasPage.redirect.statusCode)
}

// 2. Paragraph-based landing pages over GraphQL.
let page: NodeLandingPage | null = null
if (!canvasPage) {
  try {
    page = await getClient().getEntryByPath(path) as NodeLandingPage | null
  } catch {
    // Page not found
  }
  if (!page?.sections) {
    return Astro.redirect('/404')
  }
}
---

{canvasPage ? (
  <SiteLayout title={canvasPage.head?.title}>
    <CanvasComponentTree tree={canvasPage.content} />
  </SiteLayout>
) : (
  <SiteLayout title={page!.title}>
    <ParagraphRenderer sections={transformSections(page!.sections)} />
  </SiteLayout>
)}
