---
import { clsx } from 'clsx'
import type { ParagraphPricing as ParagraphPricingType, PricingTier } from '@/lib/types'
import Badge from '../ui/Badge.astro'
import PricingTierCard from './items/PricingTierCard.astro'

interface Props extends ParagraphPricingType {}

const { eyebrow, title, subtitle, tiers } = Astro.props
---

<section class="section-padding bg-gray-50" id="pricing">
  <div class="container-wide">
    {(eyebrow || title || subtitle) && (
      <div class="text-center max-w-3xl mx-auto mb-12 md:mb-16">
        {eyebrow && (
          <Badge variant="primary" class="mb-4">
            {eyebrow}
          </Badge>
        )}
        {title && (
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
            {title}
          </h2>
        )}
        {subtitle && (
          <p class="text-lg text-gray-600">{subtitle}</p>
        )}
      </div>
    )}

    {Array.isArray(tiers) && tiers.length > 0 ? (
      <div
        class={clsx(
          'grid gap-6 md:gap-8 items-start',
          tiers.length === 2 && 'md:grid-cols-2 max-w-4xl mx-auto',
          tiers.length === 3 && 'md:grid-cols-3',
          tiers.length >= 4 && 'md:grid-cols-2 lg:grid-cols-4'
        )}
      >
        {tiers.map((tier: PricingTier) => <PricingTierCard {...tier} />)}
      </div>
    ) : Astro.slots.has('default') ? (
      <div class="grid gap-6 md:gap-8 items-start md:grid-cols-3">
        <slot />
      </div>
    ) : (
      <div class="text-center py-8 text-gray-500">
        <p>No pricing tiers configured. Add tiers in the Drupal admin.</p>
      </div>
    )}
  </div>
</section>
