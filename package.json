{
  "name": "decoupled-components-astro",
  "version": "0.1.0",
  "description": "Astro starter template for Decoupled.io - headless Drupal with the Drupal Canvas visual editor",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0 <23 || >=24.5.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "NODE_EXTRA_CA_CERTS=\"$(mkcert -CAROOT 2>/dev/null)/rootCA.pem\" astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "setup": "npx decoupled-cli@2.14.1 setup --content data/components-content.json",
    "setup-content": "npx decoupled-cli@2.14.1 content import --file data/components-content.json",
    "setup-content:preview": "npx decoupled-cli@2.14.1 content import --file data/components-content.json --preview",
    "sync-schema": "npx decoupled-cli@2.14.1 schema sync",
    "check:canvas": "node scripts/check-canvas-components.mjs ../decoupled-components/canvas",
    "build:cloudflare": "DEPLOY_TARGET=cloudflare astro build"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.13",
    "@astrojs/netlify": "^6.6.5",
    "@astrojs/node": "^9.1.3",
    "@astrojs/tailwind": "^6.0.2",
    "@astrojs/vercel": "^9.0.5",
    "@drupal-canvas/headless": "^0.11.0",
    "@drupal-canvas/headless-astro": "^0.7.0",
    "@tailwindcss/typography": "^0.5.16",
    "astro": "^5.18.0",
    "clsx": "^2.1.1",
    "decoupled-cli": "2.14.1",
    "decoupled-client": "0.4.2",
    "dotenv": "^17.2.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "autoprefixer": "^10.4.20",
    "decoupled-cli": "^2.14.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.17",
    "typescript": "^5",
    "wrangler": "^4.144.0"
  }
}
